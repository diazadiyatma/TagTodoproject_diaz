<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.tagtodoproject">

    <!-- 🌐 Internet Permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 📂 Storage Permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/logodiaz"
        android:roundIcon="@drawable/logodiaz"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TagTodoproject">

        <!-- 🟡 SplashActivity sebagai LAUNCHER -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TagTodoproject.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🔷 MainActivity (bukan launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 🔐 Auth -->
        <activity
            android:name=".authentication.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".authentication.RegisterActivity"
            android:exported="false" />

        <!-- 🏠 Dashboard -->
        <activity
            android:name=".MainDashboardActivity"
            android:exported="false" />

        <!-- 📚 Halaman Tambahan -->
        <activity
            android:name=".SideActivity"
            android:exported="false" />
        <activity
            android:name=".WebViewActivity"
            android:exported="false" />

    </application>

</manifest>
