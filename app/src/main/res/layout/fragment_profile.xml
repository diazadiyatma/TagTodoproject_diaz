<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bluesantuy"
    android:fillViewport="true"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- 👤 Header: Avatar + Username + Email -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar besar -->
            <androidx.cardview.widget.CardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/user_svgrepo_com"
                    android:contentDescription="Profile Photo"
                    android:clickable="true"
                    android:focusable="true" />
            </androidx.cardview.widget.CardView>

            <!-- Username & Email -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Username"
                    android:fontFamily="@font/font_poppins"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:background="@android:color/transparent"
                    android:enabled="false" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="email@domain.com"
                    android:fontFamily="@font/font_poppins"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@color/gray"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/infoFieldsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/headerLayout"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- 📱 Contact -->
            <TextView
                android:id="@+id/tvContactLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_edittext"
                android:hint="Enter your contact"
                android:padding="12dp" />

            <!-- 📍 Location -->
            <TextView
                android:id="@+id/tvLocationLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_edittext"
                android:hint="Enter your location"
                android:padding="12dp" />

            <!-- 🚻 Gender -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvGenderLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/ivGenderDrop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_edittext"
                        android:padding="12dp"
                        android:layout_gravity="center_vertical"/>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:id="@+id/ivDropdownIcon"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Dropdown Icon"
                        android:src="@drawable/dropdown_svgrepo_com" />
                </FrameLayout>

            </LinearLayout>



            <!-- 🎂 Birth Date -->
            <TextView
                android:id="@+id/tvBirthDateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Birth Date"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/ivCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/rounded_edittext"
                    android:hint="DD/MM/YYYY"
                    android:padding="12dp"
                    android:inputType="none"
                    android:focusable="false" />

                <ImageView
                    android:id="@+id/ivCalendarIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="Calendar Icon"/>


            </RelativeLayout>


            <!-- 📝 Bio -->
            <TextView
                android:id="@+id/tvBioLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bio"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_edittext"
                android:hint="Write a short bio"
                android:padding="12dp" />
        </LinearLayout>


        <!-- ✏️ Edit Profile Button -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/infoFieldsLayout"
            android:layout_marginTop="24dp"
            android:text="Edit Profile"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:fontFamily="@font/font_poppins"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/bluet2"
            android:paddingVertical="12dp"
            android:paddingHorizontal="20dp" />

        <!-- 🚪 Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnEditProfile"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:fontFamily="@font/font_poppins"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/red"
            android:paddingVertical="12dp"
            android:paddingHorizontal="20dp" />
    </RelativeLayout>
</ScrollView>
