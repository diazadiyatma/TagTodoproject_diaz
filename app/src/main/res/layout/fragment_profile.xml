<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightGrey"
    android:fillViewport="true"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- 👤 Header: Avatar + Username + Email -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar besar -->
            <androidx.cardview.widget.CardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/account_avatar_profile_user_svgrepo_com"
                    android:contentDescription="Profile Photo"
                    android:clickable="true"
                    android:focusable="true" />
            </androidx.cardview.widget.CardView>

            <!-- Username & Email -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Username"
                    android:fontFamily="@font/font_poppins"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:background="@android:color/transparent"
                    android:enabled="false" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="email@domain.com"
                    android:fontFamily="@font/font_poppins"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@color/gray"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 📄 Info Fields -->
        <LinearLayout
            android:id="@+id/infoFieldsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/headerLayout"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <include
                android:id="@+id/itemContact"
                layout="@layout/item_profile_input" />

            <include
                android:id="@+id/itemLocation"
                layout="@layout/item_profile_input" />

            <include
                android:id="@+id/itemGender"
                layout="@layout/item_profile_input" />

            <include
                android:id="@+id/itemBirthDate"
                layout="@layout/item_profile_input" />

            <include
                android:id="@+id/itemBio"
                layout="@layout/item_profile_input" />
        </LinearLayout>

        <!-- ✏️ Edit Profile Button -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/infoFieldsLayout"
            android:layout_marginTop="24dp"
            android:text="Edit Profile"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:fontFamily="@font/font_poppins"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/yellowgold"
            android:paddingVertical="12dp"
            android:paddingHorizontal="20dp" />

        <!-- 🚪 Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnEditProfile"
            android:layout_marginTop="34dpdp"
            android:layout_marginBottom="24dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:fontFamily="@font/font_poppins"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/red"
            android:paddingVertical="12dp"
            android:paddingHorizontal="20dp" />
    </RelativeLayout>
</ScrollView>
