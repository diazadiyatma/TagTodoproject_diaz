<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    android:clipToPadding="false"
    >

    <LinearLayout
        android:id="@+id/profileContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bluesantuy"
        >

        <!-- 🔹 Profile Header (Greeting + Avatar) -->
        <LinearLayout
            android:id="@+id/headerProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="1dp">

            <!-- Text (Greeting + Name) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello!"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/font_poppins" />

                <TextView
                    android:id="@+id/textViewUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama User"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:fontFamily="@font/font_poppins" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="5dp"
                android:layout_gravity="center_horizontal"
                app:cardCornerRadius="40dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <ImageView
                    android:id="@+id/imageViewProfilePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="User avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/account_avatar_profile_user_svgrepo_com" />
            </androidx.cardview.widget.CardView>




        </LinearLayout>

        <!-- 🔸 Priority Summary -->
        <androidx.cardview.widget.CardView
            android:id="@+id/widgetPrioritySummary"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLowCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Low: 0"
                        android:textStyle="bold"
                        android:textColor="#0099cc"
                        android:textSize="16sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/font_poppins" />

                    <TextView
                        android:id="@+id/tvMediumCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Medium: 0"
                        android:textStyle="bold"
                        android:textColor="#ffbb33"
                        android:textSize="16sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/font_poppins" />

                    <TextView
                        android:id="@+id/tvHighCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="High: 0"
                        android:textStyle="bold"
                        android:textColor="#ff4444"
                        android:textSize="16sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/font_poppins" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- 🔸 Horizontal Menu Cards -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginStart="15dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="130dp"
                android:orientation="horizontal"
                android:paddingEnd="16dp">



            <!-- 🏷️ Tags -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/widgetTags"
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/greensoft"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/tags_svgrepo_com"
                            app:tint="@android:color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tags Task"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="12dp"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/font_poppins" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 🗂️ Category -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/widgetCategory"
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/yellowgold"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/category_solid_svgrepo_com"
                            app:tint="@android:color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category Task"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:textSize="12dp"
                            android:gravity="center"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/font_poppins" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 🗑️ Trash -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/widgetTrash"
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/REDPASTEL"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/trash_svgrepo_com"
                            app:tint="@android:color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trash Task"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="12dp"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/font_poppins" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 📅 Calendar -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/widgetCalendar"
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/blueslow"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@android:color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calendar Task"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="12dp"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/font_poppins" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 🔹 Today's Task Title -->
        <LinearLayout
            android:id="@+id/layoutTodayTaskContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"

            android:background="@drawable/bg_top_corners"
            android:orientation="vertical">

            <!-- 🔹 Today's Task Title -->
            <TextView
                android:id="@+id/tvTodayTaskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="15dp"
                android:fontFamily="@font/font_poppins"
                android:text="Today's Task"
                android:textColor="#000000"
                android:textSize="22dp"
                android:textStyle="bold" />

            <!-- 🔹 Task List -->
            <LinearLayout
                android:id="@+id/layoutTodayTasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
