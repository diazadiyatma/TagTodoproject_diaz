<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/yellowgold">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Info task -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTaskName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Task Name"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/font_poppins" />

            <TextView
                android:id="@+id/tvTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#Tag"
                android:textColor="@color/bluet2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_poppins" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due Date"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/font_poppins" />

            <TextView
                android:id="@+id/tvPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Priority: Medium"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/font_poppins" />
        </LinearLayout>

        <!-- 🗑️ Delete Permanen -->
        <ImageView
            android:id="@+id/ivDeletePermanent"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/delete_svgrepo"
            android:tint="@color/red"
            android:layout_marginStart="8dp"
            android:contentDescription="Delete Permanently" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
