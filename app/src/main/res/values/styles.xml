<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Kalender Header (Bulan & Tahun) -->
    <style name="CalendarHeaderText" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Nama hari Senin - Minggu -->
    <style name="CalendarWeekDayText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#888888</item>
    </style>

    <!-- Tanggal dalam grid -->
    <style name="CalendarDateText" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#222222</item>
    </style>
</resources>